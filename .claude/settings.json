{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python .claude/skills/simple-code/scripts/check_code.py *)",
      "Bash(git status*)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git push *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list*)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr merge *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.projects/vault/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push *:*)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push * --delete*)",
      "Bash(git push --delete*)",
      "Bash(git push -d*)",
      "Bash(git push * -d *)",
      "Bash(git push * main*)",
      "Bash(git push * HEAD:main*)"
    ],
    "ask": [
      "Bash(gh repo *)",
      "Bash(gh secret *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/skills/simple-code/scripts/check_code.py\" --hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/require_reviews.py\""
          }
        ]
      }
    ]
  }
}
